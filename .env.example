# =========================================================================
# Live-to-Roblox Platform — environment configuration
# Copy this file to .env (root) and to apps/backend/.env, then fill in real
# values. NEVER commit the real .env file. See docs/SETUP.md and
# docs/SECURITY.md for details on each variable.
# =========================================================================

NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------
# Persistence — omit DATABASE_URL/REDIS_URL to run fully in-memory
# (recommended for first-time local testing with the Live Simulator).
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://live_user:live_password@localhost:5432/live_platform
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------
# Dashboard auth (single-admin MVP login) and JWT signing.
# CHANGE both before any non-local deployment.
# ---------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=replace-with-a-strong-password

# ---------------------------------------------------------------------
# Roblox <-> backend authentication (see docs/ROBLOX.md).
# ROBLOX_API_KEY is the bootstrap key; additional per-game keys can be
# minted via POST /api/roblox/register from the dashboard.
# ROBLOX_COMMAND_SIGNING_SECRET must match the secret embedded in the
# Roblox SecurityService module (ReplicatedStorage/Shared/Config).
# ---------------------------------------------------------------------
ROBLOX_API_KEY=replace-with-a-long-random-string
ROBLOX_COMMAND_SIGNING_SECRET=replace-with-a-different-long-random-string
ROBLOX_GAME_ID=
ROBLOX_PLACE_ID=
# Only needed if you extend the platform with Roblox Open Cloud APIs
# (e.g. to fetch place/universe metadata). Generate at
# https://create.roblox.com/dashboard/credentials
ROBLOX_OPEN_CLOUD_API_KEY=

# ---------------------------------------------------------------------
# TikTok LIVE — see docs/TIKTOK.md. There is NO official public API for
# third-party LIVE events; TIKTOK_SIGN_API_KEY is only needed if you use
# a TikTok-Live-Connector "sign server" for scale/reliability.
# ---------------------------------------------------------------------
TIKTOK_SIGN_API_KEY=
TIKTOK_DEFAULT_USERNAME=

# ---------------------------------------------------------------------
# YouTube LIVE — official YouTube Data API v3. Create credentials at
# https://console.cloud.google.com/apis/credentials (enable "YouTube Data
# API v3" first). An API key is sufficient for public live chat reads.
# ---------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_DEFAULT_CHANNEL_ID=

# ---------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
COMMAND_EXPIRY_SECONDS=15
ROBLOX_POLL_MAX_COMMANDS=20

# Dashboard (Next.js) — public, safe to expose to the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
